PAYLOAD_SECRET=replace-with-a-long-random-string

# Local dev: leave as-is (SQLite, zero setup).
# Vercel/production: set this to a Postgres connection string instead
# (e.g. from Neon, provisioned via Vercel's Storage tab) - the app
# auto-detects Postgres vs SQLite based on this value.
DATABASE_URI=file:./payload.db

# Production only: Vercel Blob read/write token (Storage tab -> Blob).
# Leave unset locally - uploads fall back to local disk automatically.
BLOB_READ_WRITE_TOKEN=

# Donate section: from the ActBlue embed code (Dashboard -> Create form ->
# Embed form -> Embed Generator tab). Leave both unset to show the "Online
# Donations Launching Soon" placeholder instead. Safe to expose publicly -
# that's how the embed is meant to work, no secret involved.
NEXT_PUBLIC_ACTBLUE_SCRIPT_URL=
NEXT_PUBLIC_ACTBLUE_FORM_TOKEN=

# Contact + endorsement form notifications. Recipient emails are managed in
# Payload admin under Contact Settings, not here. Without a sender configured,
# submissions are still saved in Payload but no email goes out.
#
# Preferred: send through a Gmail account. Works for any recipient, no domain
# needed. GMAIL_APP_PASSWORD is a 16-character App Password from
# myaccount.google.com/apppasswords (needs 2-Step Verification on) - NOT the
# normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Fallback, used only when the Gmail vars above are unset: Resend
# (resend.com). Without a verified domain, Resend's shared test sender
# (onboarding@resend.dev) can only deliver to the Resend account's own email.
RESEND_API_KEY=

# Optional, Resend only: the "from" address, on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Google Analytics (GA4). From analytics.google.com -> Admin -> Data Streams
# -> your web stream -> Measurement ID (looks like G-XXXXXXXXXX). Leave unset
# to skip analytics entirely - nothing renders without it. Safe to expose
# publicly, this is how GA is meant to work client-side.
NEXT_PUBLIC_GA_ID=
